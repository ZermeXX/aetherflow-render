{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HISTOVIVA Manifest V8 — production contract",
  "description": "V8 capability contract; legacy manifest_version values remain accepted during migration. Unknown metadata is retained.",
  "type": "object",
  "properties": {
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "project_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]{0,159}$"
    },
    "project_type": {
      "type": "string",
      "minLength": 1
    },
    "video_title": {
      "type": "string",
      "minLength": 1
    },
    "gdrive_folder_id": {
      "type": "string"
    },
    "total_scenes": {
      "type": "integer",
      "minimum": 1
    },
    "total_duration_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "export_settings": {
      "$ref": "#/$defs/export"
    },
    "anti_desync_locks": {
      "type": "object",
      "properties": {
        "voiceover_sentence_pad_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": []
    }
  },
  "required": [
    "project_name",
    "export_settings"
  ],
  "anyOf": [
    {
      "required": [
        "timeline"
      ]
    },
    {
      "required": [
        "scenes"
      ]
    }
  ],
  "$defs": {
    "scene": {
      "type": "object",
      "properties": {
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "video_file": {
          "type": "string",
          "minLength": 1
        },
        "voiceover_file": {
          "type": "string"
        },
        "audio_file": {
          "type": "string"
        },
        "assets": {
          "type": "object",
          "properties": {
            "video_file": {
              "type": "string"
            },
            "image_reference": {
              "type": "string"
            },
            "voiceover_file": {
              "type": "string"
            },
            "ambient_audio": {
              "$ref": "#/$defs/ambient"
            }
          },
          "required": []
        },
        "camera_movement": {
          "enum": [
            "zoom_in",
            "zoom_out",
            "pan_left",
            "pan_right",
            "pan_up",
            "pan_down",
            "static"
          ]
        },
        "camera_zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.5
        },
        "transition": {
          "enum": [
            "fade",
            "dip_to_black",
            "dip_to_white",
            "cut",
            "none"
          ]
        },
        "transition_duration": {
          "type": "number",
          "minimum": 0
        },
        "voiceover_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "ambient_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "ambient_audio": {
          "$ref": "#/$defs/ambient"
        },
        "voice_start": {
          "type": "number",
          "minimum": 0
        },
        "voice_end": {
          "type": "number",
          "minimum": 0
        },
        "text_overlay": {
          "type": "string"
        },
        "lower_third": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string"
            },
            "era": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      "required": [
        "scene_id"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "duration_sec"
              ]
            },
            {
              "required": [
                "duration"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "file_name"
              ]
            },
            {
              "required": [
                "video_file"
              ]
            },
            {
              "required": [
                "assets"
              ],
              "properties": {
                "assets": {
                  "anyOf": [
                    {
                      "required": [
                        "video_file"
                      ],
                      "properties": {
                        "video_file": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    {
                      "required": [
                        "image_reference"
                      ],
                      "properties": {
                        "image_reference": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "ambient": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "file_name": {
              "type": "string",
              "minLength": 1
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            }
          },
          "required": [
            "file_name"
          ]
        }
      ]
    },
    "export": {
      "type": "object",
      "properties": {
        "resolution": {
          "enum": [
            "720p",
            "1080p",
            "4k"
          ]
        },
        "aspect_ratio": {
          "const": "16:9"
        },
        "video_codec": {
          "const": "libx264"
        },
        "profile": {
          "const": "high"
        },
        "pix_fmt": {
          "const": "yuv420p"
        },
        "cfr": {
          "const": true
        },
        "preset": {
          "enum": [
            "ultrafast",
            "veryfast",
            "medium"
          ]
        },
        "draft_mode": {
          "type": "boolean"
        },
        "crf": {
          "type": "integer",
          "minimum": 14,
          "maximum": 28
        },
        "fps": {
          "enum": [
            24,
            30,
            60
          ]
        },
        "audio_bitrate_kbps": {
          "enum": [
            192,
            256,
            320
          ]
        },
        "bitrate_mbps": {
          "type": "number",
          "minimum": 4,
          "maximum": 120
        },
        "bitrate_cap": {
          "enum": [
            "on",
            "off"
          ]
        },
        "preview_duration_sec": {
          "type": "number",
          "minimum": 0
        },
        "lower_third_config": {
          "$ref": "#/$defs/broadcast"
        },
        "brand_identity": {
          "$ref": "#/$defs/brand"
        }
      },
      "required": [
        "resolution",
        "aspect_ratio",
        "video_codec",
        "preset",
        "crf",
        "fps",
        "audio_bitrate_kbps",
        "bitrate_mbps",
        "preview_duration_sec"
      ]
    },
    "broadcast": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "style": {
          "const": "histoviva_broadcast_en"
        },
        "emblem_path": {
          "type": "string",
          "minLength": 1
        },
        "show_sec": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "anim_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "bar_bg_rgba": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": []
    },
    "brand": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "episode_label": {
          "type": "string"
        }
      },
      "required": []
    }
  }
}
